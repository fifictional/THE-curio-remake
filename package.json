{
  "name": "curio-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "db:up": "docker compose up -d postgres qdrant",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "db:rls": "tsx server/db/rls.ts",
    "web": "npm --prefix web run dev"
  },
  "dependencies": {
    "better-auth": "^1.7.23",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}