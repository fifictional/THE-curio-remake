# Postgres (docker compose)
# App role — NOT a superuser, so row-level security applies
DATABASE_URL=postgres://curio_app:curio_app@localhost:5433/curio
# Owner role — migrations / RLS setup / seed only. Never given to the running app.
DATABASE_URL_OWNER=postgres://curio:curio@localhost:5433/curio
# Service role — polling worker + indexer. BYPASSRLS, owns nothing, acts for no
# single request. Falls back to DATABASE_URL_OWNER when unset (local superuser).
DATABASE_URL_SERVICE=postgres://curio_service:curio_service@localhost:5433/curio

# API
PORT=3101

# AI — user-provided, local only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vector store (docker compose maps 6433 -> 6333; 6333 was taken)
QDRANT_URL=http://localhost:6433

# Auth (Better Auth)
BETTER_AUTH_SECRET=Z+G+++4r+nQ1RNmjO84KflvqHbdVhLUeAHidqZHscEA=
BETTER_AUTH_URL=http://localhost:3101
""
# Billing (Paddle). The webhook needs only the signing secret; checkout needs an
# API key plus a sandbox price id.
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PUBLIC_WEB_URL=http://localhost:5173

# OCR for scanned PDFs (Datalab). Text-layer PDFs do not use this.
DATALAB_API_KEY=
DATALAB_API_URL=https://api.datalab.to/api/v1/marker
